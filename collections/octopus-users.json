{
  "info": {
    "name": "Octopus - user registration & helper codes",
    "description": "Tests for POST /api/v1/users after the single-use helper-code change.\n\nRun the requests top to bottom - request 3 depends on request 2 having consumed the code.\n\nSet the collection variable `helperCode` to one of the codes in your root .env before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "helperCode", "value": "HLP-J3U6T34R" },
    { "key": "run", "value": "1", "description": "Bump this to re-run the collection with fresh usernames" }
  ],
  "item": [
    {
      "name": "1. Register a student (no code)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('role is STUDENT', () => pm.expect(pm.response.json().role).to.eql('STUDENT'));",
              "pm.test('account is active', () => pm.expect(pm.response.json().active).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"student{{run}}\",\n  \"displayName\": \"Test Student\",\n  \"password\": \"test1234\",\n  \"year\": 3\n}"
        }
      }
    },
    {
      "name": "2. Register a helper (valid code)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('role is HELPER', () => pm.expect(pm.response.json().role).to.eql('HELPER'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"helper{{run}}\",\n  \"displayName\": \"Test Helper\",\n  \"password\": \"test1234\",\n  \"year\": 4,\n  \"helperCode\": \"{{helperCode}}\"\n}"
        }
      }
    },
    {
      "name": "3. Same code again - must fail",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('message does not reveal whether the code exists', () => {",
              "  pm.expect(pm.response.text()).to.include('Invalid or already used');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"helperduplicate{{run}}\",\n  \"displayName\": \"Second Helper\",\n  \"password\": \"test1234\",\n  \"helperCode\": \"{{helperCode}}\"\n}"
        }
      }
    },
    {
      "name": "4. Privilege escalation attempt - role must be ignored",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('role is STUDENT, not ADMIN', () => pm.expect(pm.response.json().role).to.eql('STUDENT'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"escalation{{run}}\",\n  \"displayName\": \"Nice Try\",\n  \"password\": \"test1234\",\n  \"role\": \"ADMIN\"\n}"
        }
      }
    },
    {
      "name": "5. Unknown code - must fail",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"nosuchcode{{run}}\",\n  \"displayName\": \"Wrong Code\",\n  \"password\": \"test1234\",\n  \"helperCode\": \"HLP-DOESNOTEXIST\"\n}"
        }
      }
    },
    {
      "name": "6. Duplicate username - must fail",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"student{{run}}\",\n  \"displayName\": \"Same Username\",\n  \"password\": \"test1234\"\n}"
        }
      }
    },
    {
      "name": "7. Missing required fields - validation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('returns a validation message', () => pm.expect(pm.response.json().message).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"\",\n  \"password\": \"x\"\n}" }
      }
    }
  ]
}
